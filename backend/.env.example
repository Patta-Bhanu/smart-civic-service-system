# PostgreSQL database connection
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/smart_civic_system

# Generate a long random value for JWT signing
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Gmail SMTP (use a Google App Password, never your normal Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
SMTP_FROM_EMAIL=your-gmail-address@gmail.com
